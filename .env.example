# Copy to `.env` and fill in. Never commit `.env`.
# Every service below has a free tier. See docs/DEPLOYMENT.md for where to find each value.

# ---- Public (bundled into the app; safe to expose) ----
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay → Settings → API Keys (use the rzp_test_ key until you go live)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Address search provider: "osm" (free OpenStreetMap/Nominatim, default) or "google"
EXPO_PUBLIC_PLACES_PROVIDER=osm
# Only needed when EXPO_PUBLIC_PLACES_PROVIDER=google (Places API is billed beyond the free credit)
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# ---- Build-time only (read by app.config.ts, not bundled) ----
# expo.dev → your project → Project ID (created by `npx eas-cli init`)
EAS_PROJECT_ID=
# Google Cloud → Maps SDK for Android / iOS key (native map loads have no charge)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
# Path to google-services.json from Firebase (for Android push). Store as an EAS file secret in CI.
GOOGLE_SERVICES_JSON=./google-services.json
